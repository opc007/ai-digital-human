# ============================================================
# AI 数字人直播 — 环境变量配置示例
# 使用方法：复制本文件为 .env（copy .env.example .env），按需填写。
# 所有 Key 均可在 Web 控制台「配置」抽屉里填写/修改，保存后写回 .env。
# ============================================================

# ---------- 云端对话（DeepSeek，云端模式必填，本地模式可空）----------
# DeepSeek API Key，用于云端/混合模式对话。在 platform.deepseek.com 申请。
DEEPSEEK_API_KEY=
# DeepSeek 接口地址，一般不用改；兼容其它 OpenAI 格式接口时可改。
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 对话模型名，例如 deepseek-chat / deepseek-reasoner。
DEEPSEEK_MODEL=deepseek-chat
# 兼容 OpenAI 格式 Key（可选，DEEPSEEK_API_KEY 为空时作为兜底）。
OPENAI_API_KEY=
# LLM 请求超时秒数（可选，默认 60）。
# LLM_TIMEOUT_SEC=60

# ---------- 本地对话（Ollama，本地模式使用，可空）----------
# 本机 Ollama 的 OpenAI 兼容地址。
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# 本地模型名，需先 ollama pull 对应模型；未安装时会自动改用本机已装模型。
OLLAMA_MODEL=qwen2.5:7b
# Ollama API Key（可选，本机一般无需）。
# OLLAMA_API_KEY=ollama

# ---------- 云端声音（MiniMax TTS，云端模式必填，本地模式可空）----------
# MiniMax API Key，用于云端语音合成。在 minimaxi.com 申请。
MINIMAX_API_KEY=
# MiniMax Group ID，控制台账号信息里可查（部分接口需要）。
MINIMAX_GROUP_ID=
# 默认音色 ID，可在 MiniMax 平台音色列表复制。
MINIMAX_VOICE_ID=male-qn-qingse
# 语种增强 language_boost：中文直播 Chinese；粤语 Chinese,Yue；多语混杂 auto。
MINIMAX_LANGUAGE_BOOST=Chinese
# TTS 模型，如 speech-02-turbo / speech-2.6-turbo / speech-2.8-hd，以官方文档为准。
MINIMAX_MODEL=speech-02-turbo
# 情感标签（可选），如 happy / sad 等，留空用默认。
# MINIMAX_EMOTION=
# TTS 磁盘缓存：命中缓存时跳过 MiniMax 请求直接复用音频（默认开启，设 0/false/off 关闭）。
# TTS_CACHE_ENABLED=1

# ---------- 口型（MuseTalk，可空，未配置时自动回落 ffmpeg 混流）----------
# MuseTalk 仓库根目录（克隆官方/自建 MuseTalk 到本机后填）。
# MUSETALK_ROOT=
# MuseTalk 专用 Python 解释器路径（可选，默认用当前 Python）。
# MUSETALK_PYTHON=
# 自定义推理脚本路径（可选，默认 tools/musetalk_infer.py）。
# MUSETALK_SCRIPT=

# ---------- 本地生视频（ComfyUI，可空）----------
# 本机 ComfyUI 地址；Comfy Desktop 常见为 8000（不是 8188）。
COMFYUI_BASE_URL=http://127.0.0.1:8000
# 工作流 JSON 路径（可选，留空用默认 configs/comfyui/action_workflow.json）。
# COMFYUI_WORKFLOW_PATH=

# ---------- 图生视频（待机微动，商用必填）----------
# 任意兼容 OpenAI 格式的视频网关地址（NewAPI / 中转服务 / 自建网关）。
# 留空时项目将跳过 I2V 微动，使用纯动作视频兜底。
VIDEO_I2V_BASE_URL=
# API Key（控制台「配置」也可填写，仅保存在本机 .env）。
VIDEO_I2V_API_KEY=
# 模型名，按网关实际支持的图生视频模型填写（如 doubao-seedance-* / kling-* / veo3-*）。
VIDEO_I2V_MODEL=doubao-seedance-1-5-pro_720p
# 可选：时长秒数（4–11）、竖屏比例（一般不用改）。
# VIDEO_I2V_SECONDS=5
# VIDEO_I2V_SIZE=9:16

# ---------- 推流（可空，开播时也可在页面填写）----------
# demo 房间默认推流码/服务器地址；其它房间用 ROOM_{房间ID大写}_RTMP_KEY / _RTMP_URL。
ROOM_DEMO_RTMP_KEY=
# ROOM_DEMO_RTMP_URL=rtmp://...
# 画面方向：portrait 竖屏 1080×1920（抖音等）/ landscape 横屏 / square 方形。
OUTPUT_ORIENTATION=portrait
# 画面适配：contain 完整显示人物（可有黑边）/ cover 铺满画面（可能裁切）。
OUTPUT_FIT=contain
# 自定义输出宽高（可选，一般不用设，由 orientation 推导）。
# OUTPUT_WIDTH=1080
# OUTPUT_HEIGHT=1920

# ---------- 服务 ----------
# 运行环境标记：dev 开发（默认）/ production 生产。
APP_ENV=dev
# 控制台端口（默认 8100，避开本机 ComfyUI 的 8000）。
APP_PORT=8100
# 日志级别（可选，默认 INFO）。
# LOG_LEVEL=INFO
# FFmpeg 可执行文件路径（可选，默认自动探测 PATH 与常见安装位置）。
# FFMPEG_PATH=
# SQLite 数据库地址（可选，默认 data/app.db）。
# DATABASE_URL=

# ---------- 安全 ----------
# API 访问令牌（生产必改，开发默认 dev-token）。
API_TOKEN=dev-token
# 是否强制鉴权：1 强制校验 Bearer Token；dev 环境下 0 可不鉴权（默认 0）。
REQUIRE_AUTH=0
